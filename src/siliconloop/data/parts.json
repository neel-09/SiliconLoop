{
  "_doc": "Curated part cards. pins: part pin -> {'rail': '5V'|'GND'} or {'role': digital_out|pwm_out|digital_in|analog_in|servo|i2c_sda|i2c_scl, 'optional': bool}. extra.series / extra.pulldown: resistors the allocator adds (series vf may be {option, table, default} to look up by an intent option). A pin may switch role by option with role_if_option. sim: a list of model instances from sim_models.json ({model, pins: {terminal: part pin}, params ('@field' = this card's field), io: {rule key: native key}}), or the name of a template in _generic. Optional extras: safety_notes {always, on_usb}, library_packages {header: Arduino library name}, lint [{forbid|require: regex, message}]. Adding a part that behaves like an existing model type needs only a card here.",
  "_generic": {
    "generic_digital_in": {
      "doc": "Any sensor or module with one digital output (HIGH/LOW). Twin shows a toggle. Fields needed: vcc_range, active_level, rail_ma.",
      "sim": [
        {
          "model": "driven_digital",
          "pins": {
            "out": {
              "role": "digital_in"
            }
          },
          "io": {
            "active": "active"
          },
          "params": {
            "active_level": "@active_level"
          }
        }
      ]
    },
    "generic_analog_in": {
      "doc": "Any sensor or module with one analog output (0-5 V). Twin shows a slider. Fields needed: vcc_range, rail_ma.",
      "sim": [
        {
          "model": "analog_source",
          "pins": {
            "out": {
              "role": "analog_in"
            },
            "digital": {
              "role": "digital_in"
            }
          },
          "io": {
            "adc": "value"
          },
          "params": {
            "digital_active_level": "@active_level"
          }
        }
      ]
    },
    "generic_digital_out": {
      "doc": "Any module switched by one digital input pin (relay module, laser module, buzzer module). Twin shows an on/off indicator. Fields needed: vcc_range, active_level, rail_ma, pin_ma.",
      "sim": [
        {
          "model": "load",
          "pins": {
            "out": {
              "role": "digital_out"
            }
          },
          "io": {
            "active": "state"
          },
          "params": {
            "active_level": "@active_level",
            "threshold": 0.5
          }
        }
      ]
    }
  },
